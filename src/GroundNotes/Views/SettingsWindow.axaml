<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="using:GroundNotes.Views"
        xmlns:viewModels="using:GroundNotes.ViewModels"
        x:Class="GroundNotes.Views.SettingsWindow"
        Title="Settings"
        Width="760"
        Height="720"
        MinWidth="720"
        MinHeight="600"
        CanResize="True"
        SystemDecorations="None"
        ExtendClientAreaToDecorationsHint="True"
        ExtendClientAreaChromeHints="NoChrome"
        KeyDown="OnWindowKeyDown"
        WindowStartupLocation="CenterOwner">
  <Window.Styles>
    <Style Selector="Border.aiPromptRow">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderBrush" Value="{DynamicResource BorderBrushBase}" />
      <Setter Property="BorderThickness" Value="0,0,0,1" />
    </Style>
    <Style Selector="ListBox.aiPromptList ListBoxItem:pointerover Border.aiPromptRow">
      <Setter Property="Background" Value="{DynamicResource SurfaceHoverBrush}" />
    </Style>
    <Style Selector="ListBox.aiPromptList ListBoxItem:selected Border.aiPromptRow">
      <Setter Property="Background" Value="{DynamicResource SelectionBackgroundBrush}" />
    </Style>
    <Style Selector="Border.shortcutList">
      <Setter Property="Background" Value="{DynamicResource SurfaceBackgroundBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource BorderBrushBase}" />
      <Setter Property="BorderThickness" Value="1,1,1,0" />
      <Setter Property="CornerRadius" Value="1" />
    </Style>
    <Style Selector="Border.shortcutRow">
      <Setter Property="BorderBrush" Value="{DynamicResource BorderBrushBase}" />
      <Setter Property="BorderThickness" Value="0,0,0,1" />
      <Setter Property="Padding" Value="14,10" />
    </Style>

    <Style Selector="Button.shortcutChip">
      <Setter Property="MinHeight" Value="26" />
      <Setter Property="Padding" Value="8,2" />
      <Setter Property="FontFamily" Value="{DynamicResource TerminalFont}" />
      <Setter Property="FontWeight" Value="{DynamicResource TerminalFontWeight}" />
      <Setter Property="FontStyle" Value="{DynamicResource TerminalFontStyle}" />
      <Setter Property="FontSize" Value="{DynamicResource AppFontSizeSmall}" />
    </Style>
    <Style Selector="Button.shortcutBlank">
      <Setter Property="Foreground" Value="{DynamicResource SecondaryTextBrush}" />
    </Style>
    <Style Selector="Button.shortcutRowAction">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="MinWidth" Value="28" />
      <Setter Property="MinHeight" Value="28" />
      <Setter Property="Padding" Value="0" />
      <Setter Property="Foreground" Value="{DynamicResource SecondaryTextBrush}" />
      <Setter Property="FontFamily" Value="{DynamicResource TerminalFont}" />
    </Style>
    <Style Selector="Button.shortcutRowAction /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderBrush" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
    </Style>
    <Style Selector="Button.shortcutRowAction:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource SurfaceHoverBrush}" />
      <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}" />
    </Style>
  </Window.Styles>

  <Grid RowDefinitions="Auto,*,Auto">
    <!-- Title Bar -->
    <views:TitleBarControl Grid.Row="0"
                           Title="Settings"
                           TitleBarPointerPressed="OnTitleBarPointerPressed"
                           CloseRequested="OnCloseRequested" />

    <!-- Content -->
    <TabControl Grid.Row="1" Margin="0">
      <!-- Tab 1: Appearance -->
      <TabItem Header="Appearance">
        <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
          <StackPanel Margin="24,16" Spacing="24">
            <!-- General Section -->
            <StackPanel Spacing="4">
              <TextBlock Classes="settingsHeader" Text="General" />
              
              <Border Classes="settingsCard">
                <Grid ColumnDefinitions="*, Auto">
                  <StackPanel VerticalAlignment="Center" Spacing="2">
                    <TextBlock Classes="settingsLabel" Text="App Theme" />
                    <TextBlock Classes="settingsDescription" Text="Choose between Light and Dark mode." />
                  </StackPanel>
                  <ComboBox Grid.Column="1" x:Name="ThemeComboBox" Width="140" ItemsSource="{Binding ThemeNames}" SelectedItem="{Binding SelectedThemeName}" />
                </Grid>
              </Border>



              <Border Classes="settingsCard">
                <Grid ColumnDefinitions="*,Auto">
                  <StackPanel VerticalAlignment="Center" Spacing="2">
                    <TextBlock Classes="settingsLabel" Text="Show scrollbars" />
                    <TextBlock Classes="settingsDescription" Text="Lists and editors. When off, scroll with the mouse wheel or trackpad." />
                  </StackPanel>
                  <ToggleSwitch Grid.Column="1"
                                VerticalAlignment="Center"
                                IsChecked="{Binding ShowScrollBars}" />
                </Grid>
              </Border>
            </StackPanel>

            <!-- Interface Section -->
            <StackPanel Spacing="4">
              <TextBlock Classes="settingsHeader" Text="Interface" />





              <Border Classes="settingsCard">
                <Grid ColumnDefinitions="*, Auto, Auto">
                  <StackPanel VerticalAlignment="Center" Spacing="2">
                    <TextBlock Classes="settingsLabel" Text="UI Font" />
                    <TextBlock Classes="settingsDescription" Text="Font used by menus, controls, sidebar, and file names." />
                  </StackPanel>
                  <ComboBox Grid.Column="1" Width="180" Margin="12,0,0,0" ItemsSource="{Binding FontFamilies}" SelectedItem="{Binding SelectedUiFontFamilyName}" />
                  <ComboBox Grid.Column="2" Width="140" Margin="8,0,0,0" ItemsSource="{Binding UiFontVariantNames}" SelectedItem="{Binding SelectedUiFontVariantName}" />
                </Grid>
              </Border>

              <Border Classes="settingsCard">
                <Grid ColumnDefinitions="*, Auto">
                  <StackPanel VerticalAlignment="Center" Spacing="2">
                    <TextBlock Classes="settingsLabel" Text="UI Font Size" />
                    <TextBlock Classes="settingsDescription" Text="Text size used throughout the interface." />
                  </StackPanel>
                  <ComboBox Grid.Column="1" x:Name="UiFontSizeComboBox" Width="140" ItemsSource="{Binding UiFontSizes}" SelectedItem="{Binding SelectedUiFontSize}" />
                </Grid>
              </Border>
            </StackPanel>

            <!-- File List Section -->
            <StackPanel Spacing="4">
              <TextBlock Classes="settingsHeader" Text="File List" />

              <Border Classes="settingsCard">
                <Grid ColumnDefinitions="*, Auto">
                  <StackPanel VerticalAlignment="Center" Spacing="2">
                    <TextBlock Classes="settingsLabel" Text="File List Font Size" />
                    <TextBlock Classes="settingsDescription" Text="Text size used only in the file list." />
                  </StackPanel>
                  <ComboBox Grid.Column="1" Width="140" ItemsSource="{Binding FileListFontSizes}" SelectedItem="{Binding SelectedFileListFontSize}" />
                </Grid>
              </Border>

              <Border Classes="settingsCard">
                <Grid ColumnDefinitions="*,Auto">
                  <StackPanel VerticalAlignment="Center" Spacing="2">
                    <TextBlock Classes="settingsLabel" Text="Sidebar List Background" />
                    <TextBlock Classes="settingsDescription" Text="Use a theme-matched surface behind the notes list." />
                  </StackPanel>
                  <ToggleSwitch Grid.Column="1"
                                VerticalAlignment="Center"
                                IsChecked="{Binding ShowSidebarListBackground}" />
                </Grid>
              </Border>

              <Border Classes="settingsCard">
                <Grid ColumnDefinitions="*,Auto">
                  <StackPanel VerticalAlignment="Center" Spacing="2">
                    <TextBlock Classes="settingsLabel" Text="Sidebar List Border" />
                    <TextBlock Classes="settingsDescription" Text="Draw a subtle border around the notes list." />
                  </StackPanel>
                  <ToggleSwitch Grid.Column="1"
                                VerticalAlignment="Center"
                                IsChecked="{Binding ShowSidebarListBorder}" />
                </Grid>
              </Border>

            </StackPanel>

            <!-- Editor Section -->
            <StackPanel Spacing="4">
              <TextBlock Classes="settingsHeader" Text="Editor" />

              <Border Classes="settingsCard">
                <Grid ColumnDefinitions="*, Auto, Auto">
                  <StackPanel VerticalAlignment="Center" Spacing="2">
                    <TextBlock Classes="settingsLabel" Text="Editor Font" />
                    <TextBlock Classes="settingsDescription" Text="Font used by the main markdown editor." />
                  </StackPanel>
                  <ComboBox Grid.Column="1" x:Name="FontFamilyComboBox" Width="180" Margin="12,0,0,0" ItemsSource="{Binding FontFamilies}" SelectedItem="{Binding SelectedFontFamilyName}" />
                  <ComboBox Grid.Column="2" x:Name="FontVariantComboBox" Width="140" Margin="8,0,0,0" ItemsSource="{Binding FontVariantNames}" SelectedItem="{Binding SelectedFontVariantName}" />
                </Grid>
              </Border>

              <Border Classes="settingsCard">
                <Grid ColumnDefinitions="*, Auto">
                  <StackPanel VerticalAlignment="Center" Spacing="2">
                    <TextBlock Classes="settingsLabel" Text="Editor Font Size" />
                    <TextBlock Classes="settingsDescription" Text="Text size used by the main markdown editor." />
                  </StackPanel>
                  <ComboBox Grid.Column="1" x:Name="EditorFontSizeComboBox" Width="140" ItemsSource="{Binding EditorFontSizes}" SelectedItem="{Binding SelectedEditorFontSize}" />
                </Grid>
              </Border>

              <Border Classes="settingsCard">
                <Grid ColumnDefinitions="*, Auto">
                  <StackPanel VerticalAlignment="Center" Spacing="2">
                    <TextBlock Classes="settingsLabel" Text="Indent Size" />
                    <TextBlock Classes="settingsDescription" Text="Use 2 or 4 spaces when indenting with Tab." />
                  </StackPanel>
                  <ComboBox Grid.Column="1" Width="140" ItemsSource="{Binding IndentSizes}" SelectedItem="{Binding SelectedIndentSize}" />
                </Grid>
              </Border>

              <Border Classes="settingsCard">
                <Grid ColumnDefinitions="*, Auto">
                  <StackPanel VerticalAlignment="Center" Spacing="2">
                    <TextBlock Classes="settingsLabel" Text="Line Height" />
                    <TextBlock Classes="settingsDescription" Text="Adjust spacing between editor lines, including wrapped lines." />
                  </StackPanel>
                  <ComboBox Grid.Column="1" Width="140" ItemsSource="{Binding LineHeights}" SelectedItem="{Binding SelectedLineHeight}" />
                </Grid>
              </Border>
            </StackPanel>

            <!-- Code Blocks Section -->
            <StackPanel Spacing="4">
              <TextBlock Classes="settingsHeader" Text="Code Blocks" />

              <Border Classes="settingsCard">
                <Grid ColumnDefinitions="*, Auto, Auto">
                  <StackPanel VerticalAlignment="Center" Spacing="2">
                    <TextBlock Classes="settingsLabel" Text="Code Block Font" />
                    <TextBlock Classes="settingsDescription" Text="Monospaced font for code blocks." />
                  </StackPanel>
                  <ComboBox Grid.Column="1" x:Name="CodeFontFamilyComboBox" Width="180" Margin="12,0,0,0" ItemsSource="{Binding FontFamilies}" SelectedItem="{Binding SelectedCodeFontFamilyName}" />
                  <ComboBox Grid.Column="2" x:Name="CodeFontVariantComboBox" Width="140" Margin="8,0,0,0" ItemsSource="{Binding CodeFontVariantNames}" SelectedItem="{Binding SelectedCodeFontVariantName}" />
                </Grid>
              </Border>
            </StackPanel>
          </StackPanel>
        </ScrollViewer>
      </TabItem>

      <!-- Tab 2: AI Actions -->
      <TabItem Header="AI Actions">
        <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
          <StackPanel Margin="24,16" Spacing="24">
            <StackPanel Spacing="4">
              <TextBlock Classes="settingsHeader" Text="AI Integration" />
              
              <Border Classes="settingsCard">
                <Grid ColumnDefinitions="*, Auto">
                  <StackPanel VerticalAlignment="Center" Spacing="2">
                    <TextBlock Classes="settingsLabel" Text="Enable AI features" />
                    <TextBlock Classes="settingsDescription" Text="Unlock context actions like summarization and translation." />
                  </StackPanel>
                  <ToggleSwitch Grid.Column="1" x:Name="AiEnabledToggle" IsChecked="{Binding IsAiEnabled}" OnContent="" OffContent="" />
                </Grid>
              </Border>

              <Border IsEnabled="{Binding IsAiEnabled}" Classes="settingsCard">
                <Grid ColumnDefinitions="*, 330">
                  <StackPanel VerticalAlignment="Center" Spacing="2">
                    <TextBlock Classes="settingsLabel" Text="OpenAI API Key" />
                    <TextBlock Classes="settingsDescription" Text="Keys are stored locally and never shared." />
                  </StackPanel>
                  <TextBox Grid.Column="1" x:Name="ApiKeyTextBox" PasswordChar="*" Watermark="sk-..." Text="{Binding ApiKey}" />
                </Grid>
              </Border>

              <Border IsEnabled="{Binding IsAiEnabled}" Classes="settingsCard">
                <Grid ColumnDefinitions="*, 330">
                  <StackPanel VerticalAlignment="Center" Spacing="2">
                    <TextBlock Classes="settingsLabel" Text="Model ID" />
                    <TextBlock Classes="settingsDescription" Text="Default model for AI actions." />
                  </StackPanel>
                  <ComboBox Grid.Column="1" x:Name="DefaultModelTextBox" ItemsSource="{Binding AvailableModels}" SelectedItem="{Binding DefaultModel}" />
                </Grid>
              </Border>

              <Border IsEnabled="{Binding IsAiEnabled}" Classes="settingsCard">
                <Grid ColumnDefinitions="*, 330">
                  <StackPanel VerticalAlignment="Center" Spacing="2">
                    <TextBlock Classes="settingsLabel" Text="Reasoning effort" />
                    <TextBlock Classes="settingsDescription" Text="Default reasoning mode for the selected general AI model. Use none to keep costs lower." />
                  </StackPanel>
                  <ComboBox Grid.Column="1" ItemsSource="{Binding ReasoningEfforts}" SelectedItem="{Binding DefaultReasoningEffort}" />
                </Grid>
              </Border>

              <Border IsEnabled="{Binding IsAiEnabled}" Classes="settingsCard">
                <Grid ColumnDefinitions="*, Auto">
                  <StackPanel VerticalAlignment="Center" Spacing="2">
                    <TextBlock Classes="settingsLabel" Text="Enable AI title generation" />
                    <TextBlock Classes="settingsDescription" Text="Allow AI to suggest titles from the current note." />
                  </StackPanel>
                  <ToggleSwitch Grid.Column="1"
                                x:Name="TitleGenerationEnabledToggle"
                                IsChecked="{Binding IsTitleGenerationEnabled}"
                                OnContent=""
                                OffContent="" />
                </Grid>
              </Border>

              <Border IsEnabled="{Binding IsAiEnabled}" Classes="settingsCard">
                <Grid ColumnDefinitions="*, 330">
                  <StackPanel VerticalAlignment="Center" Spacing="2">
                    <TextBlock Classes="settingsLabel" Text="Title generation model" />
                    <TextBlock Classes="settingsDescription" Text="Default model used for AI title suggestions." />
                  </StackPanel>
                  <ComboBox Grid.Column="1"
                            x:Name="TitleGenerationModelComboBox"
                            ItemsSource="{Binding AvailableTitleGenerationModels}"
                            SelectedItem="{Binding TitleGenerationModel}" />
                </Grid>
              </Border>

              <Border IsEnabled="{Binding IsAiEnabled}" Classes="settingsCard">
                <Grid ColumnDefinitions="*, 330">
                  <StackPanel VerticalAlignment="Center" Spacing="2">
                    <TextBlock Classes="settingsLabel" Text="Title generation reasoning effort" />
                    <TextBlock Classes="settingsDescription" Text="Reasoning mode used for AI title suggestions. Use none to keep costs lower." />
                  </StackPanel>
                  <ComboBox Grid.Column="1"
                            ItemsSource="{Binding ReasoningEfforts}"
                            SelectedItem="{Binding TitleGenerationReasoningEffort}" />
                </Grid>
              </Border>

              <Border IsEnabled="{Binding IsAiEnabled}" Classes="settingsCard">
                <Grid ColumnDefinitions="*, 330">
                  <StackPanel VerticalAlignment="Center" Spacing="2">
                    <TextBlock Classes="settingsLabel" Text="Project ID" />
                    <TextBlock Classes="settingsDescription" Text="Optional OpenAI project identifier." />
                  </StackPanel>
                  <TextBox Grid.Column="1" x:Name="ProjectIdTextBox" Watermark="proj_..." Text="{Binding ProjectId}" />
                </Grid>
              </Border>

              <Border IsEnabled="{Binding IsAiEnabled}" Classes="settingsCard">
                <Grid ColumnDefinitions="*, 330">
                  <StackPanel VerticalAlignment="Center" Spacing="2">
                    <TextBlock Classes="settingsLabel" Text="Organization ID" />
                    <TextBlock Classes="settingsDescription" Text="Optional OpenAI organization identifier." />
                  </StackPanel>
                  <TextBox Grid.Column="1" x:Name="OrganizationIdTextBox" Watermark="org_..." Text="{Binding OrganizationId}" />
                </Grid>
              </Border>

              <Border Classes="settingsCard" Margin="0,12,0,0">
                <StackPanel Spacing="8">
                  <Grid ColumnDefinitions="*,Auto,Auto,Auto,Auto,Auto" ColumnSpacing="6">
                    <StackPanel Grid.Column="0" Spacing="2">
                      <TextBlock Classes="settingsLabel" Text="AI Prompts" />
                      <TextBlock Classes="settingsDescription" Text="Manage actions shown under the editor right-click AI menu." />
                    </StackPanel>
                    <Button Grid.Column="1" Content="Add" Click="OnAddPromptClick" />
                    <Button Grid.Column="2" Content="Edit" IsEnabled="{Binding CanEditSelectedPrompt}" Click="OnEditPromptClick" />
                    <Button Grid.Column="3" Content="Duplicate" IsEnabled="{Binding HasSelectedPrompt}" Click="OnDuplicatePromptClick" />
                    <Button Grid.Column="4" Content="Delete" IsEnabled="{Binding CanDeleteSelectedPrompt}" Click="OnDeletePromptClick" />
                    <Button Grid.Column="5" Content="Reload" Click="OnReloadPromptsClick" />
                  </Grid>

                  <Border BorderBrush="{DynamicResource BorderBrushBase}" BorderThickness="1,1,1,0" MaxHeight="280">
                    <ListBox x:Name="PromptListBox"
                             Classes="aiPromptList"
                             ItemsSource="{Binding PromptItems}"
                             SelectedItem="{Binding SelectedPrompt, Mode=TwoWay}"
                             SelectionChanged="OnPromptSelectionChanged"
                             DoubleTapped="OnPromptDoubleTapped">
                      <ListBox.ItemTemplate>
                        <DataTemplate>
                          <Border Classes="aiPromptRow"
                                  Padding="8"
                                  Cursor="Hand">
                            <Grid ColumnDefinitions="2*,*,*,Auto" ColumnSpacing="8">
                              <StackPanel Grid.Column="0" Spacing="2">
                                <TextBlock Classes="settingsLabel" Text="{Binding Name}" />
                                <TextBlock Classes="metaText" Text="{Binding Id}" />
                              </StackPanel>
                              <TextBlock Grid.Column="1" VerticalAlignment="Center" Classes="metaText" Text="{Binding Model}" TextWrapping="Wrap" />
                              <TextBlock Grid.Column="2" VerticalAlignment="Center" Classes="metaText" Text="{Binding ReasoningEffort}" TextWrapping="Wrap" />
                              <TextBlock Grid.Column="3" VerticalAlignment="Center" Classes="metaText" Text="{Binding Source}" />
                            </Grid>
                          </Border>
                        </DataTemplate>
                      </ListBox.ItemTemplate>
                    </ListBox>
                  </Border>

                  <TextBlock x:Name="PromptsFolderTextBlock" Classes="metaText" Text="{Binding PromptsDirectory}" TextWrapping="Wrap" />
                  <TextBlock Classes="settingsDescription" Text="Custom prompts are stored as .json files inside your current notes directory." />
                </StackPanel>
              </Border>
            </StackPanel>
          </StackPanel>
        </ScrollViewer>
      </TabItem>

      <TabItem Header="Slash Commands">
        <StackPanel Margin="24,16" Spacing="12">
          <TextBlock Classes="settingsHeader" Text="Slash Commands" />
          <TextBlock Classes="metaText" Text="{Binding SlashCommandsDirectory}" TextWrapping="Wrap" />
          <StackPanel Orientation="Horizontal" Spacing="6">
            <Button Content="Add" IsEnabled="{Binding CanManageSlashCommands}" Click="OnAddSlashCommandClick" />
            <Button Content="Edit" IsEnabled="{Binding HasSelectedSlashCommand}" Click="OnEditSlashCommandClick" />
            <Button Content="Duplicate" IsEnabled="{Binding HasSelectedSlashCommand}" Click="OnDuplicateSlashCommandClick" />
            <Button Content="Delete" IsEnabled="{Binding HasSelectedSlashCommand}" Click="OnDeleteSlashCommandClick" />
            <Button Content="Reload" IsEnabled="{Binding CanManageSlashCommands}" Click="OnReloadSlashCommandsClick" />
          </StackPanel>
          <Border BorderBrush="{DynamicResource BorderBrushBase}" BorderThickness="1,1,1,0" MaxHeight="360">
             <ListBox Classes="aiPromptList" ItemsSource="{Binding SlashCommandItems}" SelectedItem="{Binding SelectedSlashCommand, Mode=TwoWay}" SelectionChanged="OnSlashCommandSelectionChanged" DoubleTapped="OnSlashCommandDoubleTapped">
               <ListBox.ItemTemplate><DataTemplate><Border Classes="aiPromptRow" Padding="8"><Grid ColumnDefinitions="2*,*,3*,Auto" ColumnSpacing="8"><StackPanel><TextBlock Classes="settingsLabel" Text="{Binding Name}" /><StackPanel Orientation="Horizontal"><TextBlock Classes="metaText" Text="/" /><TextBlock Classes="metaText" Text="{Binding Id}" /></StackPanel><TextBlock Classes="metaText" Text="{Binding Aliases, StringFormat='Aliases: {0}'}" TextWrapping="Wrap" /></StackPanel><TextBlock Grid.Column="1" Classes="metaText" Text="{Binding Description}" TextWrapping="Wrap" /><TextBlock Grid.Column="2" Classes="metaText" Text="{Binding Definition.Template}" TextWrapping="Wrap" MaxLines="2" /><TextBlock Grid.Column="3" Classes="metaText" Text="{Binding Order}" /></Grid></Border></DataTemplate></ListBox.ItemTemplate>
             </ListBox>
           </Border>
           <Border IsVisible="{Binding HasSlashCommandWarnings}" BorderBrush="{DynamicResource BorderBrushBase}" BorderThickness="1" Padding="8" MaxHeight="180">
             <ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel Spacing="4"><TextBlock Classes="settingsLabel" Text="Skipped files" /><ItemsControl ItemsSource="{Binding SlashCommandWarnings}"><ItemsControl.ItemTemplate><DataTemplate><StackPanel Spacing="1"><TextBlock Classes="metaText" Text="{Binding Path}" TextWrapping="Wrap" /><TextBlock Classes="settingsDescription" Text="{Binding Reason}" TextWrapping="Wrap" /></StackPanel></DataTemplate></ItemsControl.ItemTemplate></ItemsControl></StackPanel></ScrollViewer>
           </Border>
        </StackPanel>
      </TabItem>

      <!-- Tab 3: Vim Mode -->
      <TabItem Header="Vim Mode">
        <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
          <StackPanel Margin="24,16" Spacing="24">
            <StackPanel Spacing="4">
              <TextBlock Classes="settingsHeader" Text="Vim Mode" />

              <Border Classes="settingsCard">
                <Grid ColumnDefinitions="*,Auto">
                  <StackPanel VerticalAlignment="Center" Spacing="2">
                    <TextBlock Classes="settingsLabel" Text="Enable Vim mode" />
                    <TextBlock Classes="settingsDescription" Text="Use modal Vim-style editing in note editors." />
                  </StackPanel>
                  <ToggleSwitch Grid.Column="1"
                                VerticalAlignment="Center"
                                IsChecked="{Binding IsVimModeEnabled}" />
                </Grid>
              </Border>

              <Border Classes="settingsCard" IsEnabled="{Binding IsVimModeEnabled}">
                <Grid ColumnDefinitions="*,Auto">
                  <StackPanel VerticalAlignment="Center" Spacing="2">
                    <TextBlock Classes="settingsLabel" Text="Standard Vim Ctrl bindings" />
                    <TextBlock Classes="settingsDescription" Text="Keep bindings such as Ctrl+D, Ctrl+U, Ctrl+F, and Ctrl+B available to Vim." />
                  </StackPanel>
                  <ToggleSwitch Grid.Column="1"
                                VerticalAlignment="Center"
                                IsChecked="{Binding UseStandardVimCtrlBindings}" />
                </Grid>
              </Border>

              <Border Classes="settingsCard" IsEnabled="{Binding IsVimModeEnabled}">
                <Grid ColumnDefinitions="*,Auto">
                  <StackPanel VerticalAlignment="Center" Spacing="2">
                    <TextBlock Classes="settingsLabel" Text="Key sequence timeout" />
                    <TextBlock Classes="settingsDescription" Text="Milliseconds to wait for the next key in a Vim sequence (100–5000)." />
                  </StackPanel>
                  <NumericUpDown Grid.Column="1"
                                 Width="140"
                                 Minimum="100"
                                 Maximum="5000"
                                 Increment="100"
                                 Value="{Binding VimKeySequenceTimeoutMilliseconds, Mode=TwoWay}" />
                </Grid>
              </Border>

              <Border Classes="settingsCard" IsEnabled="{Binding IsVimModeEnabled}">
                <Grid ColumnDefinitions="*,Auto">
                  <StackPanel VerticalAlignment="Center" Spacing="2">
                    <TextBlock Classes="settingsLabel" Text="Show Vim status" />
                    <TextBlock Classes="settingsDescription" Text="Show the current Vim mode and pending key sequence." />
                  </StackPanel>
                  <ToggleSwitch Grid.Column="1"
                                VerticalAlignment="Center"
                                IsChecked="{Binding ShowVimStatus}" />
                </Grid>
              </Border>
            </StackPanel>
          </StackPanel>
        </ScrollViewer>
      </TabItem>

      <!-- Tab 4: Keyboard Shortcuts -->
      <TabItem Header="Keyboard Shortcuts">
        <Grid RowDefinitions="Auto,Auto,*" Margin="24,16,24,12">
          <Grid Grid.Row="0" ColumnDefinitions="*,240,Auto" ColumnSpacing="8" Margin="0,0,0,12">
            <StackPanel Grid.Column="0" VerticalAlignment="Center" Spacing="2">
              <TextBlock Classes="settingsHeader" Margin="0" Text="Keyboard shortcuts" />
              <TextBlock Classes="settingsDescription" Margin="0" Text="{Binding ShortcutFilterSummary}" />
            </StackPanel>
            <TextBox Grid.Column="1"
                     VerticalContentAlignment="Center"
                     Watermark="Search shortcuts"
                     Text="{Binding ShortcutSearchText}" />
            <Button Grid.Column="2"
                    Classes="secondaryButton"
                    Content="Reset all"
                    Command="{Binding ResetAllShortcutsCommand}" />
          </Grid>

          <StackPanel Grid.Row="1" Margin="0,0,0,8" Spacing="2">
            <TextBlock Classes="settingsDescription"
                       IsVisible="{Binding HasShortcutConflict}"
                       Foreground="{DynamicResource SecondaryTextBrush}"
                       Text="{Binding ShortcutConflictMessage}"
                       TextWrapping="Wrap" />
            <TextBlock Classes="settingsDescription"
                       Text="{Binding ShortcutWarningMessage}"
                       TextWrapping="Wrap" />
          </StackPanel>

          <ScrollViewer Grid.Row="2"
                        HorizontalScrollBarVisibility="Disabled"
                        VerticalScrollBarVisibility="Auto">
            <Border Classes="shortcutList">
              <ItemsControl ItemsSource="{Binding FilteredShortcutActions}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate DataType="viewModels:KeyboardShortcutActionViewModel">
                    <Border Classes="shortcutRow">
                      <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="8">
                        <StackPanel Grid.Column="0" VerticalAlignment="Center" Spacing="2">
                          <TextBlock Classes="settingsLabel" Text="{Binding Name}" TextTrimming="CharacterEllipsis" />
                          <TextBlock Classes="settingsDescription" Margin="0" Text="{Binding Category}" />
                        </StackPanel>

                        <Button Grid.Column="1"
                                Classes="shortcutChip shortcutBlank"
                                VerticalAlignment="Center"
                                IsVisible="{Binding !HasBindings}"
                                Content="Blank"
                                ToolTip.Tip="Assign shortcut"
                                Click="OnAssignShortcutClick" />

                        <ItemsControl Grid.Column="1"
                                      VerticalAlignment="Center"
                                      ItemsSource="{Binding Bindings}">
                          <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                              <WrapPanel Orientation="Horizontal" />
                            </ItemsPanelTemplate>
                          </ItemsControl.ItemsPanel>
                          <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="viewModels:KeyboardShortcutBindingViewModel">
                              <StackPanel Margin="0,0,6,0" Spacing="2">
                                <Button Classes="shortcutChip"
                                        Content="{Binding CaptureButtonText}"
                                        ToolTip.Tip="Click to change. Press Backspace to clear."
                                        Click="OnRecordShortcutClick" />
                                <TextBlock Classes="settingsDescription"
                                           MaxWidth="220"
                                           IsVisible="{Binding HasValidationError}"
                                           Text="{Binding ValidationMessage}"
                                           TextWrapping="Wrap" />
                              </StackPanel>
                            </DataTemplate>
                          </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <Button Grid.Column="2"
                                Classes="shortcutRowAction"
                                Content="↺"
                                ToolTip.Tip="Reset to default"
                                Command="{Binding ResetShortcutsCommand}" />
                      </Grid>
                    </Border>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </Border>
          </ScrollViewer>
        </Grid>
      </TabItem>
    </TabControl>

    <!-- Actions -->
    <Border Grid.Row="2"
            Padding="24,12"
            BorderBrush="{DynamicResource BorderBrushBase}"
            BorderThickness="0,1,0,0">
      <TextBlock Classes="metaText"
                 HorizontalAlignment="Center"
                 Text="Changes are applied automatically." />
    </Border>
  </Grid>
</Window>
