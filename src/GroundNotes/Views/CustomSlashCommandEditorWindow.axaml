<Window xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:views="using:GroundNotes.Views" x:Class="GroundNotes.Views.CustomSlashCommandEditorWindow" Title="Slash Command" Width="620" Height="620" MinWidth="620" MinHeight="580" CanResize="False" SystemDecorations="None" ExtendClientAreaToDecorationsHint="True" ExtendClientAreaChromeHints="NoChrome" KeyDown="OnWindowKeyDown" WindowStartupLocation="CenterOwner">
  <Grid RowDefinitions="Auto,*,Auto">
    <views:TitleBarControl Grid.Row="0" Title="Slash Command" TitleBarPointerPressed="OnTitleBarPointerPressed" CloseRequested="OnCloseRequested" />
    <ScrollViewer Grid.Row="1"><StackPanel Margin="24,16" Spacing="12">
      <TextBlock Classes="settingsHeader" Text="Command Details" />
      <TextBox Watermark="Name" Text="{Binding Name}" />
      <TextBox Watermark="Command ID" Text="{Binding Id}" />
      <TextBox Watermark="Description" Text="{Binding Description}" />
      <TextBox Watermark="Aliases (comma-separated)" Text="{Binding Aliases}" />
      <TextBox Watermark="Template" Text="{Binding Template}" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="180" />
      <TextBox Watermark="Order" Text="{Binding Order}" />
      <TextBlock Classes="settingsDescription" Text="{Binding ValidationMessage}" TextWrapping="Wrap" />
    </StackPanel></ScrollViewer>
    <Border Grid.Row="2" Padding="24,12" BorderBrush="{DynamicResource BorderBrushBase}" BorderThickness="0,1,0,0"><StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8"><Button Classes="secondaryButton" Content="Cancel" Click="OnCancelClick" /><Button Content="Save" IsEnabled="{Binding CanSave}" Click="OnSaveClick" /></StackPanel></Border>
  </Grid>
</Window>
